# Nebius Token Factory API Configuration
# Base URL for Nebius Token Factory OpenAI-compatible API endpoint:
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Your Nebius API Key (do NOT commit real keys; set in .env.local):
NEBIUS_API_KEY=

# Planned model identifier.
# Real model IDs must come from the live API catalogue (e.g. meta-llama/Meta-Llama-3.1-70B-Instruct).
NEBIUS_MODEL=
